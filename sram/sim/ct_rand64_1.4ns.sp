* SRAM256 testbench: rand64, T=1.400 ns
.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice tt
.include /foss/designs/sram/cells/cells.sp
* ===== 256x1 SRAM core + I/O (generated by gen_sram.py) =====
.subckt sram256 CLK ADDR RW DIN DOUT vdd vddio vss
Xpad_CLK CLK clk_pad vddio vss bondpad
Xib_CLK clk_pad clk_in vdd vss inbuf
Xpad_ADDR ADDR addr_pad vddio vss bondpad
Xib_ADDR addr_pad addr_in vdd vss inbuf
Xpad_RW RW rw_pad vddio vss bondpad
Xib_RW rw_pad rw_in vdd vss inbuf
Xpad_DIN DIN din_pad vddio vss bondpad
Xib_DIN din_pad din_in vdd vss inbuf
Xpad_DOUT DOUT dout_pad vddio vss bondpad
* --- clock distribution: root buffer + 3 balanced branches
Xck_r1 clk_in ckr_b vdd vss inv wn=1.68 wp=3.36
Xck_r2 ckr_b ckr vdd vss inv wn=3.36 wp=6.72
Xck_a1 ckr cka_b vdd vss inv wn=0.84 wp=1.68
Xck_a2 cka_b clk_ff vdd vss inv wn=1.68 wp=3.36
Xck_b1 ckr ckb1 vdd vss inv wn=0.84 wp=1.68
Xck_b2 ckb1 ckb2 vdd vss inv wn=1.26 wp=2.52
Xck_b3 ckb2 clkb vdd vss inv wn=2.52 wp=5.04
Xck_d1 ckr d1 vdd vss inv
Xck_d2 d1 d2 vdd vss inv
Xck_d3 d2 d3 vdd vss inv
Xck_d4 d3 d4 vdd vss inv
Xck_d5 d4 d5 vdd vss inv
Xck_d6 d5 d6 vdd vss inv
Xck_d7 d6 d7 vdd vss inv
Xck_d8 d7 ckd vdd vss inv
Xck_c1 ckr ckd pc0 vdd vss nand2 wn=1.68 wp=1.68
Xck_c2 pc0 pc1 vdd vss inv wn=0.84 wp=1.68
Xck_c3 pc1 pcb vdd vss inv wn=2.52 wp=5.04
* --- serial address shift register (a0 = newest bit, a7 = oldest = MSB)
Xff_a0 addr_in clk_ff_s1 a0 ab0 vdd vss dff
Xff_a1 a0 clk_ff_s2 a1 ab1 vdd vss dff
Xff_a2 a1 clk_ff_s3 a2 ab2 vdd vss dff
Xff_a3 a2 clk_ff_s4 a3 ab3 vdd vss dff
Xff_a4 a3 clk_ff_s5 a4 ab4 vdd vss dff
Xff_a5 a4 clk_ff_s6 a5 ab5 vdd vss dff
Xff_a6 a5 clk_ff_s7 a6 ab6 vdd vss dff
Xff_a7 a6 clk_ff_s8 a7 ab7 vdd vss dff
Xff_rw rw_in clk_ff_s9 rwq rwqb vdd vss dff
Xff_din din_in clk_ff_s10 dinq dinqb vdd vss dff
Xpd_rh0 ab7 ab6 rhb0 vdd vss nand2
Xpi_rh0 rhb0 rh0 vdd vss inv wn=0.84 wp=1.68
Xpd_rh1 ab7 a6 rhb1 vdd vss nand2
Xpi_rh1 rhb1 rh1 vdd vss inv wn=0.84 wp=1.68
Xpd_rh2 a7 ab6 rhb2 vdd vss nand2
Xpi_rh2 rhb2 rh2 vdd vss inv wn=0.84 wp=1.68
Xpd_rh3 a7 a6 rhb3 vdd vss nand2
Xpi_rh3 rhb3 rh3 vdd vss inv wn=0.84 wp=1.68
Xpd_rl0 ab5 ab4 rlb0 vdd vss nand2
Xpi_rl0 rlb0 rl0 vdd vss inv wn=0.84 wp=1.68
Xpd_rl1 ab5 a4 rlb1 vdd vss nand2
Xpi_rl1 rlb1 rl1 vdd vss inv wn=0.84 wp=1.68
Xpd_rl2 a5 ab4 rlb2 vdd vss nand2
Xpi_rl2 rlb2 rl2 vdd vss inv wn=0.84 wp=1.68
Xpd_rl3 a5 a4 rlb3 vdd vss nand2
Xpi_rl3 rlb3 rl3 vdd vss inv wn=0.84 wp=1.68
Xpd_ch0 ab3 ab2 chb0 vdd vss nand2
Xpi_ch0 chb0 ch0 vdd vss inv wn=0.84 wp=1.68
Xpd_ch1 ab3 a2 chb1 vdd vss nand2
Xpi_ch1 chb1 ch1 vdd vss inv wn=0.84 wp=1.68
Xpd_ch2 a3 ab2 chb2 vdd vss nand2
Xpi_ch2 chb2 ch2 vdd vss inv wn=0.84 wp=1.68
Xpd_ch3 a3 a2 chb3 vdd vss nand2
Xpi_ch3 chb3 ch3 vdd vss inv wn=0.84 wp=1.68
Xpd_cl0 ab1 ab0 clb0 vdd vss nand2
Xpi_cl0 clb0 cl0 vdd vss inv wn=0.84 wp=1.68
Xpd_cl1 ab1 a0 clb1 vdd vss nand2
Xpi_cl1 clb1 cl1 vdd vss inv wn=0.84 wp=1.68
Xpd_cl2 a1 ab0 clb2 vdd vss nand2
Xpi_cl2 clb2 cl2 vdd vss inv wn=0.84 wp=1.68
Xpd_cl3 a1 a0 clb3 vdd vss nand2
Xpi_cl3 clb3 cl3 vdd vss inv wn=0.84 wp=1.68
